{
  "name": "pi-plan-ng",
  "version": "0.2.2",
  "description": "Claude Code-style plan mode for pi: restricted planning loop with a persistent PLAN.md, profiles that bring in more execution/tool types (extra bash commands like julia, MCP tools like kaimon), configurable thinking effort, and /plan go execution tracked via todos (rpiv-todo).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csvance/pi-plan-ng.git"
  },
  "keywords": ["pi-package", "pi", "plan-mode", "extension", "planning"],
  "files": [
    "index.ts",
    "utils.ts",
    "diff.ts",
    "plan-view.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "plan-mode.config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "diff": "8.0.4",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
